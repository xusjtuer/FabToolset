{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "FabToolset",
	"Description": "MCP toolset for the Fab ecosystem: search the public catalog, browse the signed-in user's library, pull signed download info and start the Fab plugin's Add to Project import, plus read-only inventory of locally imported assets and the Vault cache.",
	"Category": "Other",
	"EditorOnly": true,
	"CreatedBy": "",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": true,
	"NoRedist": true,
	"EnabledByDefault": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "FabToolset",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"TargetAllowList": [ "Editor" ]
		}
	],
	"Plugins": [
		{
			"Name": "ToolsetRegistry",
			"Enabled": true
		},
		{
			"Name": "Fab",
			"Enabled": true
		}
	]
}
